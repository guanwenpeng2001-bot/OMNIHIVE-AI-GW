[Unit]
Description=OmniHive - AI API Gateway Platform
Documentation=https://github.com/guanwenpeng2001-bot/OMNIHIVE-AI-GW
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=omnihive
Group=omnihive
WorkingDirectory=/opt/omnihive
ExecStart=/opt/omnihive/omnihive
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omnihive

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/omnihive /etc/omnihive

Environment=CONFIG_FILE=/etc/omnihive/config.yaml
Environment=OMNIHIVE_DATA_DIR=/opt/omnihive/data

# Environment - Server configuration
# Modify these values to change listen address and port
Environment=GIN_MODE=release
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080

[Install]
WantedBy=multi-user.target
