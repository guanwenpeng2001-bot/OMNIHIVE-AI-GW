{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniHive plugin manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "publisher_id", "id", "name", "version", "requires", "capabilities", "runtimes", "files"],
  "properties": {
    "schema_version": {"const": 2},
    "product_id": {"const": "omnihive"},
    "publisher_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "description": {"type": "string"},
    "requires": {
      "type": "object", "additionalProperties": false,
      "required": ["omnihive", "plugin_protocol", "transport_api", "ui_bridge"],
      "properties": {
        "omnihive": {"type": "string", "minLength": 1},
        "recommended_omnihive_version": {"type": "string"},
        "tested_omnihive_versions": {"type": "array", "items": {"type": "string"}},
        "plugin_protocol": {"const": 2}, "transport_api": {"const": 1}, "ui_bridge": {"const": 1}
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {"id": {"enum": ["provider","task","ui"]}, "platform": {"type": "string"}, "account_type": {"type": "string"}},
        "if": {"properties": {"id": {"const": "provider"}}},
        "then": {"required": ["platform", "account_type"], "properties": {"platform": {"const": "openai"}, "account_type": {"const": "oauth"}}},
        "else": {"properties": {"platform": {"const": ""}, "account_type": {"const": ""}}}
      }
    },
    "runtimes": {
      "type": "object", "additionalProperties": false, "required": ["wasip1-wasm"],
      "properties": {"wasip1-wasm": {"type": "object", "required": ["path"], "additionalProperties": false, "properties": {"path": {"type": "string", "pattern": "\\.wasm$"}}}}
    },
    "ui": {"type": "object", "additionalProperties": false, "properties": {"entrypoint": {"type": "string"}}},
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["plugin_id","key_id","archive_sha256","manifest_sha256"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/id"}, "key_id": {"type": "string","minLength": 1},
        "archive_sha256": {"$ref": "#/$defs/digest"}, "manifest_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string","pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string","pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$","maxLength": 160}
  }
}
