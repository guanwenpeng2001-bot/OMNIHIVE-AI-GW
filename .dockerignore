# =============================================================================
# Docker Ignore File for OmniHive
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Local cloud/agent credentials and developer state must never reach a build
# daemon or remote BuildKit context.
.aws/
.ssh/
.agents/
.codex/
.cache/

# Private keys and certificates at any depth.
**/*.pem
**/*.key

# Documentation
*.md
!deploy/DOCKER.md
docs/
# admin-compliance gate (LegalDocumentView.vue) build-time imports
# docs/legal/*.md?raw into the frontend bundle; keep that subtree in the
# Docker build context even though docs/ is otherwise excluded.
!docs/legal/
!docs/legal/*.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/

# Node modules (will be installed in container)
frontend/node_modules/
node_modules/
tools/pi-catalog/node_modules/

# Go build cache (will be built in container)
backend/vendor/

# Test files
*_test.go
**/*.test.js
coverage/
.nyc_output/

# Environment files at any depth (keep example templates)
**/.env
**/.env.*
!**/.env.example

# 本地闭源插件目录可能包含发布签名私钥，绝不能进入 Docker 构建上下文。
/plugins/

# Local config at any depth
**/config.yaml
**/config.local.yaml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Deploy files (not needed in image)
deploy/install.sh
deploy/omnihive.service
deploy/omnihive-sudoers
deploy/data/
deploy/postgres_data/
deploy/redis_data/

# GoReleaser
.goreleaser.yaml

# GitHub
.github/

# Claude files
.claude/
issues/
CLAUDE.md

# Local process and dependency audit artifacts
.pi/
**/.pi/
**/audit.json

# Local generated outputs and quality-gate state.
outputs/
.quality-gate/
